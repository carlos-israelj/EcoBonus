{
  "name": "@stellar-scaffold/ui",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev --workspace templates/react -- --host 0.0.0.0",
    "start": "npm run dev",
    "build": "npm run build --workspace templates/react",
    "preview": "npm run preview --workspace templates/react -- --host 0.0.0.0",
    "test:frontend": "playwright test --config e2e/ecobonus.config.ts",
    "lint:frontend": "npm run lint --workspace templates/react",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "workspaces": [
    "templates/*",
    "app-lib",
    "app-lib/clients/*",
    "e2e"
  ],
  "devDependencies": {
    "prettier": "^3.9.8"
  },
  "prettier": "@theahaco/ts-config/prettier",
  "dependencies": {
    "@trustless-work/escrow": "^3.0.5"
  }
}
