# Server Configuration
PORT=3001
NODE_ENV=development

# Stellar Network
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_PASSPHRASE=Test SDF Network ; September 2015

# Smart Contract Addresses (Deploy contracts and update these)
MISSION_CONTRACT_ID=
REWARD_CONTRACT_ID=
CERTIFICATE_NFT_CONTRACT_ID=

# Admin Wallet (for validation operations - generate with stellar-cli)
# NEVER commit real secret keys to git!
ADMIN_SECRET_KEY=
ADMIN_PUBLIC_KEY=

# Supabase Configuration
# Get these from https://app.supabase.com/project/_/settings/api
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Privy Authentication
# Get these from https://dashboard.privy.io/
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Trustless Work API (optional)
TRUSTLESS_WORK_API_KEY=
TRUSTLESS_WORK_API_URL=https://dev.api.trustlesswork.com

# Database (legacy - now using Supabase)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecobonus
DB_USER=postgres
DB_PASSWORD=

# IPFS Configuration
IPFS_HOST=ipfs.infura.io
IPFS_PORT=5001
IPFS_PROTOCOL=https
IPFS_PROJECT_ID=
IPFS_PROJECT_SECRET=

# AI Service
AI_SERVICE_URL=http://localhost:5000
AI_SERVICE_API_KEY=

# Application Settings
MAX_MISSION_RADIUS=5000
MIN_EVIDENCE_PHOTOS=2
VALIDATION_TIMEOUT_HOURS=24
